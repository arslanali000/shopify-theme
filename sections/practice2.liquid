
{% comment %} Shopify Section {% endcomment %}

<style>
 .collection-list-container-{{section.id}}{
  width: 95vw;
  display: flex;
  gap: 3rem;
  box-sizing: border-box;
  justify-content: center;
  margin-left:auto;
  margin-right:auto;

 }
 .collection-image-{{ section.id }}{
  width: 25%;
  height: auto;
  object-fit: cover;
  cursor:pointer;
  
 }
 .sellers{
text-align: center;
}
@media screen and (max-width:767px){
.collection-list-container-{{section.id}}{
  width: 90vw;
  display: flex;
  flex-direction: column;
  align-items: center;

}
.collection-image-{{ section.id }}{
  width: 100%;
  
  
  
 }
}
 </style>



<div class="sellers">
{{ section.settings.collection-list-heading }} 
</div>
<div class="collection-list-container-{{section.id}}">
  
 {% for block in section.blocks %}
   <a class="collection-link{{ section.id }}" href="{{ block.settings.collection_link }}">
   </a>
   <img  class="collection-image-{{ section.id }}" src="{{ block.settings.collection_image | img_url:''}}" alt="">
   
 {% endfor %}
 </div>
{% schema %}
 {
  "name": "Collection List",
  "settings": [
    {
    "type": "richtext",
    "id": "collection-list-heading",
    "label": "Collection Heading",
    "default":"<h3>Explore our Best Sellers</h4>"
    }
  ],
  "blocks": [
   {
    "type": "collection-list",
    "name": "Collection",
    "settings": [
     {
     "type": "image_picker",
     "id": "collection_image",
     "label": "Select Image"

     },
     {
     "type": "url",
     "id": "collection_link",
     "label": "Select Collection"
     }
    ]
   }
  ],
  "presets": [
   {
   "name": "Collection List"
  }
  ]
 }
{% endschema %}