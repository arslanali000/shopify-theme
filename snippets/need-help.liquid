<style>
.need-help-container {
  width: 100%;
}

  .need-help-content {
  background-color:#E8E9EB; /*change the background color*/
  padding: 15px;
  border-radius:10px;
  margin-top:15px;
  width:100%;
  color:rgb(0, 0, 0); /*change the color of the text*/
  }
  
  .need-help-card .need-help-link {
      text-decoration: none;
      color: #000000; /*change the color of the links*/
  }
  
  .need-help-card svg {
    width: 20px;
    vertical-align: middle;
    color: #000000; /*change the color of the icons*/
  }

</style>

<div class="need-help-container">
  <div class="need-help-content">
    <b>
      <strong>{{ block.settings.help_title }}</strong>
    </b>
    <br>
    <small>{{ block.settings.help_availibility }}</small>
    <div class="need-help-card">
     <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
      </svg>

      <small>
        {% capture product_url %}{{ shop.url }}{{ product.url }}{% endcapture %}
        {% capture product_name %}{{ product.title | url_escape }}{% endcapture %}
        <a
          class="need-help-link"
          href="https://wa.me/+{{ block.settings.help_order_on_whatsapp }}?text=Hello, I%20would%20like%20to%20buy%20this%20product:%20{{ product_name }}%20{{ product_url }}"
          >Order on WhatsApp</a
        > <!-- Change your whatsapp number and add the country code first -->
      </small>
    </div>
   <div class="need-help-card">
     <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.501 48.172 48.172 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
     </svg>
     <small>
        <a class="need-help-link" href="https://wa.me/+{{ block.settings.help_chat_on_whatsapp }}?text=Hey+there%2C+I+have+a+question%21">
            Chat on WhatsApp: +{{ block.settings.help_chat_on_whatsapp }}
        </a> 
      </small>
   </div>
    <div class="need-help-card">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
    </svg>
      <small>
        <a class="need-help-link" href="mailto:{{ block.settings.help_support_email }}">Email: {{ block.settings.help_support_email }}</a>
      </small>
    </div>
  </div>

</div>
