

<style>
    .collection-slider-wrapper-- {
        width: 100%;
        max-width: 1600px;
        display: flex;
        justify-content: flex-start;
        align-items: flex-start;
        gap: 1.5rem;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-behavior: smooth;
        box-sizing: border-box;
        padding-block: 20px;
        padding-inline: 20px;
        margin: {{ margin_block }}px auto;
      --content-width: {{ collection_width }}px;
    }

  /*To center the main container keeping the horizontal scroll */
      .collection-slider-wrapper--::before,
      .collection-slider-wrapper--::after {
        content: "";
        margin: auto;
      }

    .collection-slider-content-- {
        width: var(--content-width);
        height: auto;
        min-height: var(--content-width);
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: center;
        flex-shrink: 0;
      }

      .collection-slider-content-- a {
        width: 100%;
        height: 100%;
        text-decoration: none;  
        font-size: 1.5rem;
        text-align: center;
        color: #1e1e1e;
      }

      .collection-image-wrapper {
        width: 100%;
        height: auto;
        aspect-ratio: 1/1;
        border-radius: 50%;   
        margin-bottom: 5px;
      }
     
    .collection-image-wrapper img {
        width: 100%;
        height: 100%;
        aspect-ratio: 1/1;
        object-fit: cover;
        border-radius: 50%;
        padding: 3px;
        background: {{ gradient_color }} padding-box;
    }

    .collection-image-wrapper:hover img  {
        transform: scale(1.1);
        transform-origin: center;
        transition: transform 0.3s ease;
    }

    @media only screen and (max-width: 992px) {
      .collection-slider-wrapper-- {
          scrollbar-width: none;
      }
      
     .collection-slider-content-- {
          width: calc(var(--content-width)/1.5);
          min-height: calc(var(--content-width)/1.5);
      }
    .collection-slider-wrapper--::-webkit-scrollbar {
        display: none;
      }
 
    .collection-slider-content-- a {
      font-size: 1.2rem;
      }
    }

  @media only screen and (max-width: 640px){
    .collection-slider-content-- {
      width: calc(var(--content-width)/2);
      min-height: calc(var(--content-width)/2);
    }
  }


 / * ===== Scrollbar CSS ===== */
.collection-slider-wrapper-- {
    scrollbar-width: auto;
    scrollbar-color: #FF6347 #FFFFE0;
  }

  /* Chrome, Edge, and Safari */
  .collection-slider-wrapper--::-webkit-scrollbar {
    width: 16px;
  }

  .collection-slider-wrapper--::-webkit-scrollbar-track {
    background: #FFFFE0;
    border-radius: 100px;
  }

  .collection-slider-wrapper--::-webkit-scrollbar-thumb {
    background-color: {{ scrollbar_color }};
    border-radius: 100px !important;
    border: 3px solid #ffffff;
  }

/* ===== Scrollbar CSS ===== */


</style>

<div class="collection-slider-content--" {{ block.shopify_attributes }}>
    <a href="{{ collection_url }}">
      <div class="collection-image-wrapper">
      {% if collection_image != blank %}
        {{ collection_image | image_url: width: 200, height: 200 | image_tag: alt: collection.name, crop: "center" }}
      {% endif %}
      </div>
      {% if collection_name != blank %}
	      {{ collection_name }}
	    {% endif %}
    </a>
</div>



