<style>
      fieldset.custom-fields--gm {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        border: 2px dotted lightgray;
        border-radius: 8px;
      }

      fieldset.custom-fields--gm legend span.heart-emoji {
        font-size: 2rem;
        display: inline-block;
        animation: heartbeat-gm 2s linear infinite;
      }

      @keyframes heartbeat-gm {
        0% {
          transform: scale(1);
        }

        25% {
          transform: scale(1);
        }

        30% {
          transform: scale(1.4);
        }

        50% {
          transform: scale(1.2);
        }

        70% {
          transform: scale(1.4);
        }

        100% {
          transform: scale(1);
        }
      }
    </style>

<fieldset class="custom-fields--gm">
      <legend>
        <span class="heart-emoji">💖</span> <span>{{ 'My heart beats for you' }}</span>
      </legend>
      <div class="field">
        <input
          required
          class="field__input"
          type="text"
          id="lucky-one"
          name="properties[Lucky One]"
          form="product-form-{{ section.id }}"
          value=""
          placeholder="You the lucky one"
        />
        <label class="field__label" for="lucky-one">{{ 'You the lucky one' }}</label>
      </div>

      <div class="field">
        <input
          required
          class="field__input"
          type="text"
          id="beloved-partner"
          name="properties[Partner Name]"
          form="product-form-{{ section.id }}"
          value=""
          placeholder="Your beloved partner"
        />
        <label class="field__label" for="beloved-partner"
          >{{ 'Beloved partner' }}</label
        >
      </div>
    </fieldset>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      document.querySelector("form[novalidate]").removeAttribute("novalidate");
    });
  </script>